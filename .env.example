# API
VITE_API_URL=http://localhost:8039

# Auth — Firebase (production)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Dev login (no Firebase needed): sign in as Bearer dev:<uid>:<email>
VITE_AUTH_TEST_MODE=1

# Credits (optional)
VITE_REVENUECAT_API_KEY=
# Shared consumables store (RevenueCat Web billing).
# TODO(product): set this and configure RevenueCat offerings to enable buying
# credits through @sudobility/consumables_pages. Without it the store renders
# its empty state and purchasing is stubbed.
VITE_REVENUECAT_API_KEY_WEB=
