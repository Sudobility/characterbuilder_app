{
  "name": "characterbuilder_app",
  "version": "0.1.35",
  "private": true,
  "type": "module",
  "description": "CharacterBuilder web app (Vite + React): login, FaceSpec editor, image generation, gallery, credits",
  "license": "BUSL-1.1",
  "author": "Sudobility",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "localize": "SCRIPT=$(mktemp) && curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/localize_batch.cjs -o $SCRIPT && WHISPERLY_API_KEY=$(grep -h '^WHISPERLY_API_KEY=' ~/.develop/.keys ~/.keys ~/.keys.txt 2>/dev/null | head -1 | cut -d= -f2-) node $SCRIPT ./public/locales https://api.whisperly.dev/api/v1/translate/jie9cytr/characterbuilder && rm -f $SCRIPT && prettier public/locales --write",
    "localize_local": "SCRIPT=$(mktemp) && curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/localize_batch.cjs -o $SCRIPT && node $SCRIPT ./public/locales http://localhost:8021/api/v1/translate/jie9cytr/characterbuilder && rm -f $SCRIPT && prettier public/locales --write",
    "process:static": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/process-static-files.ts -o /tmp/process-static-files.ts && bunx tsx /tmp/process-static-files.ts",
    "seo:fetch": "curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-seo-assets-v2.mjs -o /tmp/generate-seo-assets.mjs",
    "generate:sitemap": "bun run seo:fetch && node /tmp/generate-seo-assets.mjs public",
    "prerender": "node scripts/prerender.mjs",
    "prerender:install": "bunx playwright install --with-deps chromium",
    "generate": "bun run process:static && bun run generate:sitemap && bun run prerender:install && bun run prerender"
  },
  "dependencies": {
    "@revenuecat/purchases-js": "~1.73.1",
    "@sudobility/auth_lib": "^0.0.130",
    "@sudobility/building_blocks": "^0.0.375",
    "@sudobility/characterbuilder_client": "^0.1.18",
    "@sudobility/characterbuilder_lib": "^0.1.15",
    "@sudobility/characterbuilder_types": "^0.1.14",
    "@sudobility/components": "^5.3.68",
    "@sudobility/consumables_client": "^0.0.42",
    "@sudobility/consumables_pages": "^0.0.76",
    "@sudobility/design": "^1.1.71",
    "@sudobility/di": "^1.5.87",
    "@sudobility/di_web": "^0.1.285",
    "@sudobility/resources_client": "^0.1.1",
    "@sudobility/resources_pages": "^0.1.2",
    "@sudobility/seo_lib": "^0.0.52",
    "@sudobility/types": "^1.10.1",
    "@tanstack/react-query": "~5.104.5",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "firebase": "~12.19.0",
    "i18next": "~26.3.1",
    "i18next-browser-languagedetector": "~8.2.1",
    "i18next-http-backend": "~4.0.4",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~17.0.8",
    "react-router-dom": "~7.18.4",
    "tailwind-merge": "~3.7.0",
    "zustand": "~5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitejs/plugin-react": "~5.1.2",
    "autoprefixer": "~10.6.1",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "playwright": "~1.64.1",
    "postcss": "~8.5.31",
    "tailwindcss": "~3.4.19",
    "tsx": "~4.23.15",
    "typescript": "~6.0.3",
    "vite": "~7.3.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/characterbuilder_app.git"
  }
}
