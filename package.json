{
  "name": "characterbuilder_app",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "CharacterBuilder web app (Vite + React): login, FaceSpec editor, image generation, gallery, credits",
  "license": "BUSL-1.1",
  "author": "Sudobility",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "process:static": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/process-static-files.ts -o /tmp/process-static-files.ts && bunx tsx /tmp/process-static-files.ts",
    "seo:fetch": "curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-seo-assets-v2.mjs -o /tmp/generate-seo-assets.mjs",
    "generate:sitemap": "bun run seo:fetch && node /tmp/generate-seo-assets.mjs public",
    "prerender": "node scripts/prerender.mjs",
    "prerender:install": "bunx playwright install --with-deps chromium",
    "generate": "bun run process:static && bun run generate:sitemap && bun run prerender:install && bun run prerender"
  },
  "dependencies": {
    "@sudobility/auth-components": "^1.0.12",
    "@sudobility/auth_lib": "^0.0.119",
    "@sudobility/building_blocks": "^0.0.341",
    "@sudobility/characterbuilder_client": "^0.1.5",
    "@sudobility/characterbuilder_lib": "^0.1.5",
    "@sudobility/characterbuilder_types": "^0.1.6",
    "@sudobility/components": "^5.3.44",
    "@sudobility/design": "^1.1.66",
    "@sudobility/di": "^1.5.79",
    "@sudobility/di_web": "^0.1.262",
    "@sudobility/seo_lib": "^0.0.47",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "firebase": "~12.19.0",
    "i18next": "~25.10.10",
    "i18next-browser-languagedetector": "~8.2.1",
    "i18next-http-backend": "~3.0.6",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-i18next": "~16.6.6",
    "react-router-dom": "~7.18.4",
    "tailwind-merge": "~3.7.0",
    "zustand": "~5.0.16"
  },
  "devDependencies": {
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~5.2.0",
    "autoprefixer": "~10.6.1",
    "postcss": "~8.5.31",
    "tailwindcss": "~3.4.19",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "playwright": "~1.64.1",
    "tsx": "~4.23.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/characterbuilder_app.git"
  }
}
