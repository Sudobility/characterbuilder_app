{
  "name": "characterbuilder_app",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "CharacterBuilder web app (Vite + React): login, FaceSpec editor, image generation, gallery, credits",
  "license": "BUSL-1.1",
  "author": "Sudobility",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "process:static": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/process-static-files.ts -o /tmp/process-static-files.ts && bunx tsx /tmp/process-static-files.ts",
    "seo:fetch": "curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-seo-assets-v2.mjs -o /tmp/generate-seo-assets.mjs",
    "generate:sitemap": "bun run seo:fetch && node /tmp/generate-seo-assets.mjs public",
    "prerender": "node scripts/prerender.mjs",
    "prerender:install": "bunx playwright install --with-deps chromium",
    "generate": "bun run process:static && bun run generate:sitemap && bun run prerender:install && bun run prerender"
  },
  "dependencies": {
    "@sudobility/auth-components": "^1.0.11",
    "@sudobility/auth_lib": "^0.0.110",
    "@sudobility/building_blocks": "^0.0.330",
    "@sudobility/characterbuilder_client": "^0.1.2",
    "@sudobility/characterbuilder_lib": "^0.1.2",
    "@sudobility/characterbuilder_types": "^0.1.3",
    "@sudobility/components": "^5.3.33",
    "@sudobility/design": "^1.1.58",
    "@sudobility/di": "^1.5.70",
    "@sudobility/di_web": "^0.1.251",
    "@sudobility/seo_lib": "^0.0.39",
    "@sudobility/types": "^1.9.68",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.4.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.3",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "playwright": "^1.60.0",
    "tsx": "^4.21.0"
  }
}
